<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>

    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>asc</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>OpenPGP Text File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>pgp</string>
                <string>gpg</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>OpenPGP Binary File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>sig</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>OpenPGP Signature</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cer</string>
                <string>crt</string>
                <string>der</string>
                <string>p12</string>
                <string>p7c</string>
                <string>pfx</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>X509 Certificate File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>p7m</string>
                <string>p7s</string>
                <string>pem</string>
                <string>crl</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>CMS (S/MIME) File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>eml</string>
                <string>mim</string>
                <string>mime</string>
                <string>mbox</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>E-Mail file</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>kgrp</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>CFBundleTypeName</key>
            <string>Kleopatra Certificate Group</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>

    </array>
</dict>
</plist>
