      <table id="table-key-filters-criteria">
	<title
>مفاتيح ضبط مرشح المفاتيح التي تعرّف معايير الترشيح</title>
	<tgroup cols="3">
	  <colspec colnum="2" align="center"/>
	  <thead>
	    <row>
	      <entry
>مفتاح الضبط</entry>
	      <entry
